{
  "name": "askcruz-mailbox",
  "version": "1.0.0",
  "private": true,
  "description": "AskCruz Mailbox — unified premium inbox and MCP server for all AskCruz SpaceMail mailboxes",
  "type": "module",
  "engines": { "node": ">=20" },
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,cyan \"node --watch-path=server server/index.js\" \"vite\"",
    "server": "node server/index.js",
    "build": "vite build",
    "start": "node server/index.js",
    "export-env": "node scripts/export-env.js",
    "mcp": "node server/mcp/stdio.js",
    "import": "node scripts/import-mailboxes.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "dotenv": "^18.0.0",
    "express": "^5.2.1",
    "imapflow": "^2.0.5",
    "mailparser": "^3.9.28",
    "nodemailer": "^10.0.10",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.1.1",
    "autoprefixer": "^10.6.1",
    "concurrently": "^10.0.5",
    "lucide-react": "^1.47.0",
    "postcss": "^8.5.28",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwindcss": "^3.4.19",
    "vite": "^8.3.0"
  }
}
