# Password for the web dashboard login (leave empty to disable login — local use only)
APP_PASSWORD=
# Bearer token for the HTTP MCP endpoint at /mcp (leave empty to disable it)
MCP_TOKEN=
# API server
PORT=4000
HOST=127.0.0.1
# Background sync
SYNC_INTERVAL_SEC=120
SYNC_CONCURRENCY=8
INBOX_DEPTH=60
SENT_DEPTH=30
MAX_IMAP_CONNECTIONS=100
